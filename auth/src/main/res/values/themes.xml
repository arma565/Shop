<resources>
    <!-- Base application theme. -->
    <style name="Theme.Property" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="itemTextAppearance">@style/ThemeActionBarColor</item>
        <item name="actionOverflowButtonStyle">@style/ThreeDotColor</item>
    </style>

    <style name="ThemeActionBarColor" parent="TextAppearance.AppCompat.Widget.ActionBar.Menu">
        <item name="actionMenuTextColor">@color/white</item>
        <item name="android:actionMenuTextColor">@color/white</item>
    </style>
    
    <style name="ThreeDotColor" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="tint">@color/black</item>
    </style>
    
</resources>